{
  "UUID": "com.avonderau.ts3deck",
  "Name": "TeamSpeak 3",
  "Version": "0.3.0.0",
  "Author": "avonderau",
  "Description": "Control the TeamSpeak 3 client from your Deck: mute, sound, away, push-to-talk, channel switching and a status key. Talks to TeamSpeak through ClientQuery.",
  "URL": "https://github.com/avonderau/openaction-ts3plugin",
  "Icon": "imgs/plugin",
  "Category": "TeamSpeak 3",
  "CategoryIcon": "imgs/plugin",
  "CodePathLin": "bin/x86_64-unknown-linux-gnu/ts3deck",
  "CodePathWin": "bin/windows/ts3deck.exe",
  "CodePathMac": "bin/macos/ts3deck",
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "bin/x86_64-unknown-linux-gnu/ts3deck",
    "aarch64-unknown-linux-gnu": "bin/aarch64-unknown-linux-gnu/ts3deck",
    "x86_64-pc-windows-msvc": "bin/windows/ts3deck.exe",
    "aarch64-apple-darwin": "bin/macos/ts3deck",
    "x86_64-apple-darwin": "bin/macos/ts3deck"
  },
  "PropertyInspectorPath": "ui/inspector.html",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "Actions": [
    {
      "UUID": "com.avonderau.ts3deck.mic",
      "Name": "Toggle microphone",
      "Tooltip": "Mute or unmute your microphone",
      "Icon": "imgs/mic-on",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/mic-on"
        },
        {
          "Image": "imgs/mic-off"
        }
      ]
    },
    {
      "UUID": "com.avonderau.ts3deck.speakers",
      "Name": "Toggle sound",
      "Tooltip": "Mute or unmute your speakers or headphones",
      "Icon": "imgs/speakers-on",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/speakers-on"
        },
        {
          "Image": "imgs/speakers-off"
        }
      ]
    },
    {
      "UUID": "com.avonderau.ts3deck.away",
      "Name": "Toggle away",
      "Tooltip": "Set yourself away, with an optional message",
      "Icon": "imgs/away-off",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/away-off"
        },
        {
          "Image": "imgs/away-on"
        }
      ]
    },
    {
      "UUID": "com.avonderau.ts3deck.ptt",
      "Name": "Push to talk",
      "Tooltip": "Transmit while the key is held (TeamSpeak capture mode: Continuous Transmission)",
      "SupportedInMultiActions": false,
      "Icon": "imgs/ptt-idle",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/ptt-idle"
        },
        {
          "Image": "imgs/ptt-live"
        }
      ]
    },
    {
      "UUID": "com.avonderau.ts3deck.channel",
      "Name": "Join channel",
      "Tooltip": "Switch to a channel on the current server",
      "Icon": "imgs/channel-off",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/channel-off"
        },
        {
          "Image": "imgs/channel-on"
        }
      ]
    },
    {
      "UUID": "com.avonderau.ts3deck.status",
      "Name": "Status",
      "Tooltip": "Shows your channel and how many people are in it; lights up while you talk",
      "Icon": "imgs/status-idle",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/status-idle"
        },
        {
          "Image": "imgs/status-talking"
        }
      ]
    }
  ],
  "OS": [
    {
      "Platform": "linux"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ]
}
